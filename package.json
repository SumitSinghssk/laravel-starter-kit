{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node setup.cjs && vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{js,jsx,ts,tsx,css,vue,blade.php}\"",
        "format:check": "prettier --check \"resources/**/*.{js,jsx,ts,tsx,css,vue,blade.php}\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
